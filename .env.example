# Supabase, values supplied automatically by the Vercel Supabase integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Vite browser aliases. The Vercel build config maps these automatically from SUPABASE_*
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public site URL, used for sitemap/canonical metadata
VITE_SITE_URL=https://your-domain.example

# Optional AI provider. Leave unset if AI features are not needed.
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
